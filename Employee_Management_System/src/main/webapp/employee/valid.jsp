<title>Employee Management System</title>
</head>
<!-- Update validation page to check employee id is exists -->
<body>
<%@page import="employeerecord.database.*" %>
    <%Employee em = new Employee();
    
    //employee id
    String empid = request.getParameter("emp-up");
    
    //To check that the employee id is exists
    boolean updateval=em.updatevalidation(empid);
    
    if(updateval==false){%>
    <jsp:include page="update.jsp"></jsp:include>
        <div class="errors1">
        <img src="../imagefolder/binoculus1.png" width="150" height="150">
    	<%=em.getError() %>
        </div>
        <%}
    else if(updateval==true){
        session.setAttribute("empid",empid);
        response.sendRedirect("upval.jsp");
        }
    %>

</body>
</html>